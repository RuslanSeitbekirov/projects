import math

# ============ ЗАДАНИЕ 1: проверка гипотезы о стрельбе (биномиальный критерий) ============
def binom_pmf(k, n, p):
    return math.comb(n, k) * p**k * (1-p)**(n-k)

def binom_cdf(k, n, p):                 # P(X <= k)
    return sum(binom_pmf(i, n, p) for i in range(0, k+1)) if k >= 0 else 0.0

def binom_sf(k, n, p):                  # P(X >= k)
    return sum(binom_pmf(i, n, p) for i in range(k, n+1)) if k <= n else 0.0

def critical_values(n, p0, alpha):
    """Двусторонняя область: отвергаем H0, если m <= k_low или m >= k_high.
    В каждом хвосте не более alpha/2."""
    k_high = next((k for k in range(n+1) if binom_sf(k, n, p0) <= alpha/2), n+1)
    k_low = -1
    for k in range(n+1):
        if binom_cdf(k, n, p0) <= alpha/2: k_low = k
        else: break
    return k_low, k_high

def power(n, p0, p1, alpha, side="two"):
    if side == "upper":      # H1: p1 > p0
        k_high = next((k for k in range(n+1) if binom_sf(k, n, p0) <= alpha), n+1)
        return binom_sf(k_high, n, p1)
    k_low, k_high = critical_values(n, p0, alpha)
    return binom_cdf(k_low, n, p1) + binom_sf(k_high, n, p1)

def shooting_test(n, m, p0, p1, alpha, target_power=0.8):
    k_low, k_high = critical_values(n, p0, alpha)
    pw = power(n, p0, p1, alpha)
    print(f"n={n}, промахов m={m}, p0={p0}, p1={p1}, alpha={alpha}")
    print(f"Нижняя граница: m <= {k_low}  |  верхняя граница: m >= {k_high}")
    if m <= k_low or m >= k_high:
        print("Результат: H0 отвергается")
    else:
        print("Результат: нет оснований отвергнуть H0")
    # p-value (двустороннее, удвоением меньшего хвоста)
    pv = min(1.0, 2*min(binom_cdf(m, n, p0), binom_sf(m, n, p0)))
    print(f"p-value ≈ {pv:.4f}")
    print(f"Мощность = {pw:.4f}, ошибка II рода beta = {1-pw:.4f}")
    # минимальное n для желаемой мощности
    for nn in range(5, 2000):
        if power(nn, p0, p1, alpha) >= target_power:
            print(f"Для мощности >= {target_power} нужно n >= {nn}"); break
    return k_low, k_high, pw

if __name__ == "__main__":
    print("=== Задание 1 ===")
    shooting_test(n=20, m=9, p0=0.3, p1=0.5, alpha=0.05, target_power=0.8)
    print("\nЗависимость границ от alpha (n=20, p0=0.3):")
    for al in (0.2, 0.1, 0.05, 0.01, 0.001):
        kl, kh = critical_values(20, 0.3, al)
        print(f"alpha={al:<6} нижняя m<={kl:<3} верхняя m>={kh:<3} мощность={power(20,0.3,0.5,al):.3f}")
    print("\nМощность от n (p0=0.3, p1=0.5, alpha=0.05):")
    for nn in (10, 20, 40, 80, 120):
        print(f"n={nn:<4} мощность={power(nn,0.3,0.5,0.05):.3f}")