<Window x:Class="Exercise2TestHarness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exercise 3 Test Harness — Length / Mass"
        Height="470" Width="560" MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Левая колонка: управление устройством -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <GroupBox Header="Units" Padding="6" Margin="0,0,0,8">
                <StackPanel>
                    <RadioButton x:Name="imperialRadio" Content="Imperial" IsChecked="True" Margin="0,2"/>
                    <RadioButton x:Name="metricRadio" Content="Metric" Margin="0,2"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Device" Padding="6" Margin="0,0,0,8">
                <StackPanel>
                    <RadioButton x:Name="lengthRadio" Content="Length Device (длина)" IsChecked="True" Margin="0,2"/>
                    <RadioButton x:Name="massRadio" Content="Mass Device (масса)" Margin="0,2"/>
                </StackPanel>
            </GroupBox>

            <Button x:Name="createInstance" Content="Create Instance"
                    Click="createInstance_Click"/>  
            <Button x:Name="startCollecting" Content="Start Collecting"
                    Click="startCollecting_Click" IsEnabled="False"/>
            <Button x:Name="stopCollecting" Content="Stop Collecting"
                    Click="stopCollecting_Click" IsEnabled="False"/>
            <Separator Margin="0,4,0,10"/>
            <Button x:Name="getMetricValue" Content="Get Metric Value"
                    Click="getMetricValue_Click" IsEnabled="False"/>
            <Button x:Name="getImperialValue" Content="Get Imperial Value"
                    Click="getImperialValue_Click" IsEnabled="False"/>
            <Button x:Name="getRawData" Content="Get Raw Data"
                    Click="getRawData_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- Правая колонка: результаты -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" x:Name="metricLabel" Content="Metric Value:"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="metricValueBox"
                     IsReadOnly="True" Margin="0,4" VerticalContentAlignment="Center"/>

            <Label Grid.Row="1" x:Name="imperialLabel" Content="Imperial Value:"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="imperialValueBox"
                     IsReadOnly="True" Margin="0,4" VerticalContentAlignment="Center"/>

            <Label Grid.Row="2" Grid.ColumnSpan="2" Content="Raw Data (кольцевой буфер на 10 значений):"
                   Margin="0,8,0,0"/>
            <ListBox Grid.Row="3" Grid.ColumnSpan="2" x:Name="rawDataValues"/>
        </Grid>

        <!-- Строка состояния -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="statusText"
                   Margin="0,10,0,0" Foreground="Gray"
                   Text="Выберите единицы и создайте устройство."/>
    </Grid>
</Window>
