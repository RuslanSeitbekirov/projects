<Window x:Class="GreatestCommonDivisorStein.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Алгоритмы Евклида и Штейна"
        Height="460" Width="680"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="10">

        <!-- ===== Вкладка 1: сравнение Евклида и Штейна ===== -->
        <TabItem Header="НОД: Евклид и Штейн">
            <StackPanel Margin="15">
                <TextBlock Text="Введите два неотрицательных целых числа:" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="First number"/>
                        <TextBox x:Name="firstNumberTextBox" Width="160" Padding="3" Text="298467352"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Second number"/>
                        <TextBox x:Name="secondNumberTextBox" Width="160" Padding="3" Text="569484"/>
                    </StackPanel>
                    <Button x:Name="findGCD2" Content="Find GCD (2 Integers)"
                            Padding="10,4" VerticalAlignment="Bottom"
                            Click="findGCD_Click"/>
                </StackPanel>

                <Label x:Name="resultEuclid" Content="Euclid: —" FontSize="16" FontWeight="Bold"/>
                <Label x:Name="resultStein"  Content="Stein: —"  FontSize="16" FontWeight="Bold"/>

                <TextBlock x:Name="comparisonText" Margin="5,10,0,0" TextWrapping="Wrap"
                           Foreground="DimGray"/>
            </StackPanel>
        </TabItem>

        <!-- ===== Вкладка 2: простое число через цифру 2 и сдвиги ===== -->
        <TabItem Header="Простое число через 2 и сдвиги">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Найти наибольшее простое число, меньшее N, и записать его только цифрой 2, побитовыми сдвигами, скобками, плюсом и минусом."/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="N:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="nTextBox" Width="160" Padding="3" Text="100"/>
                    <Button x:Name="findPrimeButton" Content="Найти"
                            Width="100" Margin="10,0,0,0" Click="findPrimeButton_Click"/>
                </StackPanel>

                <Label Grid.Row="2" x:Name="primeLabel" Content="Простое число: —"
                       FontSize="16" FontWeight="Bold"/>

                <TextBox Grid.Row="3" x:Name="expressionTextBox"
                         IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="14"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Grid.Row="4" x:Name="verifyText" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="DimGray"/>
            </Grid>
        </TabItem>

    </TabControl>
</Window>