<Window x:Class="GreatestCommonDivisorОverloading.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GreatestCommonDivisorОverloading"
        Width="800"
        Height="450"
        Title="MainWindow"
        mc:Ignorable="d">
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="55.999999999999986" />
      <ColumnDefinition Width="1.0011376564277588*" />
    </Grid.ColumnDefinitions>
    <!-- Поле ввода 1 -->
    <TextBlock Margin="0,0,10,8"
               VerticalAlignment="Center"
               Text="Число A:"
               Grid.Column="0"
               Grid.Row="0" />
    <TextBox x:Name="InputA"
             Margin="0,-0.3999999999999879,0,8.399999999999991"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Text="0"
             Grid.Column="1"
             Grid.Row="0" />
    <!-- Поле ввода 2 -->
    <TextBlock Margin="0,0,10,8"
               VerticalAlignment="Center"
               Text="Число B:"
               Grid.Column="0"
               Grid.Row="1" />
    <TextBox x:Name="InputB"
             Margin="0,0,0,8"
             Text="0"
             Grid.Column="1"
             Grid.Row="1" />
    <!-- Кнопка -->
    <!-- Поле вывода -->
    <TextBox Width="57"
             Margin="0,27.4,0,287"
             HorizontalAlignment="Left"
             VerticalAlignment="Stretch"
             Text="Число С:"
             Grid.Column="0"
             Grid.ColumnSpan="2"
             Grid.Row="3" />
    <TextBox x:Name="InputC"
             Margin="-4.263256414560601E-14,27.20000000000001,0,288.79999999999995"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Text="0"
             Grid.Column="1"
             Grid.Row="3" />
    <TextBox Width="56"
             Margin="0,53.4,0,261"
             HorizontalAlignment="Left"
             VerticalAlignment="Stretch"
             Text="Число D:"
             Grid.Column="0"
             Grid.Row="3" />
    <TextBox x:Name="InputD"
             Margin="0,53.59999999999999,0,262.4"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Text="0"
             Grid.Column="1"
             Grid.Row="3" />
    <TextBox Width="57"
             Margin="0,81.20000000000002,0,233.2"
             HorizontalAlignment="Left"
             VerticalAlignment="Stretch"
             Text="Число E:"
             Grid.Column="0"
             Grid.ColumnSpan="2"
             Grid.Row="3" />
    <TextBox x:Name="InputE"
             Margin="-4.263256414560601E-14,80.80000000000004,0,235.19999999999996"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Text="0"
             Grid.Column="1"
             Grid.Row="3" />
    <Button x:Name="BtnFindGcd"
            Content="Найти НОД"
            Margin="0,162.00000000000003,0,152.39999999999998"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Click="BtnFindGcd_Click"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="3" />
    <TextBlock Height="19"
               Margin="14,0,8.799999999999997,118"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Bottom"
               RenderTransformOrigin="0.7373,3.15"
               Text="НОД:"
               Grid.Column="0"
               Grid.Row="3" />
    <TextBox x:Name="OutputResult"
             Margin="-4.263256414560601E-14,197.20000000000002,0,118.80000000000001"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="LightGray"
             FontWeight="Bold"
             IsReadOnly="True"
             Grid.Column="1"
             Grid.Row="3" />
  </Grid>
</Window>