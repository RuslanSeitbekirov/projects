<Window x:Class="GreatestCommonDivisorОverloading.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GreatestCommonDivisorОverloading"
        Width="800"
        Height="450"
        Title="MainWindow"
        mc:Ignorable="d">
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="0" />
      <RowDefinition Height="334" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="55.999999999999986" />
      <ColumnDefinition Width="1.0011376564277588*" />
    </Grid.ColumnDefinitions>
    <!-- Поле ввода 1 -->
    <TextBlock Margin="0,0,10,8"
               VerticalAlignment="Center"
               Text="Число A:"
               Grid.Column="0"
               Grid.Row="0" />
    <TextBox x:Name="InputA"
             Margin="0,-0.3999999999999879,0,8.399999999999991"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Text="0"
             Grid.Column="1"
             Grid.Row="0" />
    <!-- Поле ввода 2 -->
    <TextBlock Margin="0,0,10,8"
               VerticalAlignment="Center"
               Text="Число B:"
               Grid.Column="0"
               Grid.Row="1" />
    <TextBox x:Name="InputB"
             Margin="0,0,0,8"
             Text="0"
             Grid.Column="1"
             Grid.Row="1" />
    <!-- Кнопка -->
    <!-- Поле вывода -->
    <TextBlock Width="57"
               Margin="0,9,0,306"
               HorizontalAlignment="Left"
               VerticalAlignment="Stretch"
               Text="Число С:"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               Grid.Row="3" />
    <TextBox x:Name="InputC"
             Margin="0,9,0,307"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Text="0"
             Grid.Column="1"
             Grid.Row="3" />
    <TextBlock Width="56"
               Margin="0,36,0,280"
               HorizontalAlignment="Left"
               VerticalAlignment="Stretch"
               Text="Число D:"
               Grid.Column="0"
               Grid.Row="3" />
    <TextBox x:Name="InputD"
             Margin="0,36,0,280"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Text="0"
             Grid.Column="1"
             Grid.Row="3" />
    <TextBlock Width="57"
               Height="18"
               Margin="0,0,703,253"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Text="Число E:"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               Grid.Row="3" />
    <TextBox x:Name="InputE"
             Margin="0,63,0,253"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Text="0"
             Grid.Column="1"
             Grid.Row="3" />
    <Button x:Name="BtnFindGcd"
            Content="Найти НОД"
            Margin="492,89,19,210"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Click="BtnFindGcd_Click"
            Grid.Column="1"
            Grid.Row="3" />
    <TextBlock Height="19"
               Margin="23,0,0,217.5"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Bottom"
               RenderTransformOrigin="0.7373,3.15"
               Text="НОД:"
               Grid.Column="0"
               Grid.Row="3" />
    <TextBox x:Name="OutputResult"
             Margin="40,98,242,218"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="LightGray"
             FontWeight="Bold"
             IsReadOnly="True"
             Grid.Column="1"
             Grid.Row="3" />
    <TextBox x:Name="Input2"
             Width="500"
             Height="20.5"
             Margin="197,140,0,0"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Grid.Column="1"
             Grid.Row="3" />
    <TextBlock Width="250"
               Height="29"
               Margin="8,140,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Text="Введите числа через запятую с пробелом:"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               Grid.Row="3" />
    <TextBox x:Name="OutputResult2"
             Margin="40,194,242,122"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="LightGray"
             FontWeight="Bold"
             IsReadOnly="True"
             Grid.Column="1"
             Grid.Row="3" />
    <Button x:Name="BtnFindGcd2"
            Content="Найти НОД"
            Margin="492,185.5,19,113.5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Click="BtnFindGcd2_Click"
            Grid.Column="1"
            Grid.Row="3" />
    <TextBlock Height="19"
               Margin="23,0,0,121"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Bottom"
               RenderTransformOrigin="0.7373,3.15"
               Text="НОД:"
               Grid.Column="0"
               Grid.Row="3" />
  </Grid>
</Window>