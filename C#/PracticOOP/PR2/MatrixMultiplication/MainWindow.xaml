<Window x:Class="MatrixMultiplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Умножение матриц"
        Height="560" Width="980" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Matrix 1: строк" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="m1RowsComboBox" Width="55" Margin="0,0,12,0"
                      SelectionChanged="dimension_Changed"/>

            <TextBlock Text="столбцов" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="m1ColumnsComboBox" Width="55" Margin="0,0,20,0"
                      SelectionChanged="dimension_Changed"/>

            <TextBlock Text="Matrix 2: строк" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock x:Name="m2RowsText" FontWeight="Bold" VerticalAlignment="Center"
                       MinWidth="20" ToolTip="Равно числу столбцов Matrix 1"/>

            <TextBlock Text="столбцов" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="m2ColumnsComboBox" Width="55" Margin="0,0,20,0"
                      SelectionChanged="dimension_Changed"/>

            <CheckBox x:Name="realNumbersCheckBox" Content="Вещественные числа"
                      VerticalAlignment="Center" Margin="0,0,15,0"
                      Click="dimension_Changed"/>

            <Button x:Name="randomizeButton" Content="Заполнить случайно"
                    Padding="10,4" Margin="0,0,10,0" Click="randomizeButton_Click"/>
            <Button x:Name="buttonCalculate" Content="Calculate"
                    Padding="20,4" FontWeight="Bold" Click="buttonCalculate_Click"/>
        </WrapPanel>

        <!-- Три матрицы; у каждой — полосы прокрутки -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="matrix1Group" Grid.Column="0" Header="Matrix 1" Margin="0,0,5,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="grid1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </ScrollViewer>
            </GroupBox>

            <GroupBox x:Name="matrix2Group" Grid.Column="1" Header="Matrix 2" Margin="5,0,5,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="grid2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </ScrollViewer>
            </GroupBox>

            <GroupBox x:Name="resultGroup" Grid.Column="2" Header="Result Matrix" Margin="5,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="grid3" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</Window>