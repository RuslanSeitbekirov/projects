<Window x:Class="GreatestCommonDivisor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск НОД" Height="220" Width="300" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Поле ввода 1 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Число A:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="InputA" Margin="0,0,0,8"/>

        <!-- Поле ввода 2 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Число B:" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="InputB" Margin="0,0,0,8"/>

        <!-- Кнопка -->
        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                Content="Найти НОД" x:Name="BtnFindGcd" 
                Click="BtnFindGcd_Click" Margin="0,5,0,15" HorizontalAlignment="Stretch"/>

        <!-- Поле вывода -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="НОД:" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="OutputResult" 
                 IsReadOnly="True" Background="LightGray" FontWeight="Bold"/>
    </Grid>
</Window>