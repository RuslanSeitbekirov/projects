<Window x:Class="SwitchTestHarness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Failsafe: аварийное отключение"
        Height="450" Width="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" x:Name="button1" Content="Shutdown"
                Padding="20,6" FontWeight="Bold"
                HorizontalAlignment="Left" Margin="0,0,0,10"
                Click="Button1_Click"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="textBlock1" FontFamily="Consolas" FontSize="13"
                       TextWrapping="Wrap"/>
        </ScrollViewer>
    </Grid>
</Window>