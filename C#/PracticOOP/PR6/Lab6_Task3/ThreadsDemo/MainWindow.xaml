<Window x:Class="ThreadsDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практика 6, задание 3 — многопоточность"
        Height="720" Width="760" MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Пункт 1: гонка шариков ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="startRace" Content="1. Старт гонки (Thread, Join, Barrier)"
                    Click="startRace_Click" Padding="10,4"/>
            <TextBlock Text="Проверять состояние потоков каждые" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <!-- SelectionChanged срабатывает, когда выбран другой пункт списка -->
            <ComboBox x:Name="intervalBox" Width="70" SelectedIndex="1"
                      SelectionChanged="intervalBox_SelectionChanged">
                <ComboBoxItem Content="100"/>
                <ComboBoxItem Content="250"/>
                <ComboBoxItem Content="500"/>
                <ComboBoxItem Content="1000"/>
            </ComboBox>
            <TextBlock Text="мс" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>

        <!-- Дорожка. Canvas — панель, где у каждого элемента заданы координаты
             (Canvas.Left и Canvas.Top). Код меняет Canvas.Left шариков. -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left">
            <Canvas x:Name="track" Width="700" Height="150" Background="#FFF7F7F7">
                <!-- Контрольная точка (здесь шарики ждут друг друга — Barrier) -->
                <Line X1="352" Y1="0" X2="352" Y2="150" Stroke="Orange" StrokeThickness="2" StrokeDashArray="4 3"/>
                <TextBlock Canvas.Left="358" Canvas.Top="2" Text="Barrier" Foreground="Orange"/>
                <!-- Финиш -->
                <Line X1="672" Y1="0" X2="672" Y2="150" Stroke="Black" StrokeThickness="2"/>

                <!-- Три шарика. Каждым управляет свой поток. -->
                <Ellipse x:Name="ball0" Width="30" Height="30" Fill="Red"   Canvas.Left="0" Canvas.Top="15"/>
                <Ellipse x:Name="ball1" Width="30" Height="30" Fill="Green" Canvas.Left="0" Canvas.Top="60"/>
                <Ellipse x:Name="ball2" Width="30" Height="30" Fill="Blue"  Canvas.Left="0" Canvas.Top="105"/>
            </Canvas>
        </Border>

        <!-- Состояние потоков (обновляется по таймеру) -->
        <TextBlock Grid.Row="2" x:Name="threadStates" FontFamily="Consolas" Margin="0,8,0,8"
                   Text="Потоки ещё не созданы. Нажмите «Старт гонки»."/>

        <!-- ===== Пункты 2–6: опыты ===== -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,8">
            <Button x:Name="lockDemo" Content="2. lock и Monitor" Click="lockDemo_Click" Padding="10,4" Margin="0,0,6,0"/>
            <Button x:Name="mutexDemo" Content="3. Мьютекс и семафор" Click="mutexDemo_Click" Padding="10,4" Margin="0,0,6,0"/>
            <Button x:Name="taskDemo" Content="4. Task" Click="taskDemo_Click" Padding="10,4" Margin="0,0,6,0"/>
            <Button x:Name="parallelDemo" Content="5. Parallel.For" Click="parallelDemo_Click" Padding="10,4" Margin="0,0,6,0"/>
            <Button x:Name="asyncDemo" Content="6. async / await" Click="asyncDemo_Click" Padding="10,4" Margin="0,0,6,0"/>
            <Button x:Name="clearLog" Content="Очистить" Click="clearLog_Click" Padding="10,4"/>
        </WrapPanel>

        <!-- Сюда выводятся результаты опытов -->
        <TextBox Grid.Row="4" x:Name="logBox" IsReadOnly="True" FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"/>
    </Grid>
</Window>
