<Window x:Class="XMLTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="800"
        Height="450"
        Title="MainWindow">
    
  <!-- Убрали x:Name="Cube" отсюда -->
  <Grid RenderTransformOrigin="0.5114,0.378">
    
    <Button x:Name="RandomColor"
            Content="Random Color"
            Width="120" Height="29"
            Margin="274,254,0,0"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Click="RandomColorButton_Click" />
            
    <Button x:Name="RandomForm"
            Content="Random Form"
            Width="120" Height="29"
            Margin="0,254,247,0"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Click="RandomFormButton_Click" />
            
    <!-- Добавили x:Name="Cube" сюда, вместо Label2 -->
    <Label x:Name="Cube"
           Content="Измени меня"
           Width="269" Height="197"
           Margin="274,42,0,0"
           HorizontalAlignment="Left" VerticalAlignment="Top"
           HorizontalContentAlignment="Center"
           Background="White"
           BorderBrush="#FFD82B2B"
           FontSize="30"
           Foreground="Black" />
  </Grid>
</Window>