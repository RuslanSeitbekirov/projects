<Window x:Class="RealNumberInput.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод вещественного числа" Height="150" Width="320"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Введите вещественное число со знаком:" Margin="0,0,0,8"/>
            <TextBox x:Name="NumberTextBox"
                     FontSize="16"
                     Padding="5"
                     MaxLength="20"
                     PreviewTextInput="NumberTextBox_PreviewTextInput"
                     PreviewKeyDown="NumberTextBox_PreviewKeyDown"
                     DataObject.Pasting="NumberTextBox_Pasting" TextChanged="NumberTextBox_TextChanged"/>
            <TextBlock x:Name="ResultText" Margin="0,10,0,0" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>