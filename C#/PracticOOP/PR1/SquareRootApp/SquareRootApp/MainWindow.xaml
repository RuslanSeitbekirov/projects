<Window x:Class="SquareRootApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вычисление квадратного корня методом Ньютона"
        Height="480" Width="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ввод числа -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Введите число:" VerticalAlignment="Center" Width="110"/>
            <TextBox x:Name="inputTextBox" Width="150" FontSize="14" Padding="3"/>
            <Button x:Name="calculateButton" Content="Вычислить"
                    Width="110" Margin="10,0,0,0" Click="calculateButton_Click"/>
                                        <!-- Ссылка на функцию обработчик ↑-->
        </StackPanel>

        <!-- Результат Math.Sqrt -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,6">
            <TextBlock Text="Результат .NET (Math.Sqrt):" Width="200"/>
            <Label x:Name="frameWorkLabel" Content="—" FontWeight="Bold"/>
        </StackPanel>

        <!-- Результат метода Ньютона -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,6">
            <TextBlock Text="Результат Ньютона (decimal):" Width="200"/>
            <Label x:Name="newtonLabel" Content="—" FontWeight="Bold"/>
        </StackPanel>

        <!-- Пошаговый режим (обязательное дополнение) -->
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,10,0,6">
            <Button x:Name="nextStepButton" Content="Следующая итерация"
                    Width="160" IsEnabled="False" Click="nextStepButton_Click"/> 
                                        <!-- Ссылка на функцию обработчик ↑-->
            <TextBlock x:Name="iterationCountText" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Журнал итераций (приближение и погрешность):" Margin="0,5,0,3"/>

        <ListBox x:Name="iterationsListBox" Grid.Row="5" FontFamily="Consolas" FontSize="12"/>
    </Grid>
</Window>
